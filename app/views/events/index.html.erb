<% content_for :title, (@agent ? I18n.t('huginn.events.agent_events_title', agent_name: @agent.name) : I18n.t('huginn.events.title')) -%>

<div class='container'>
  <div class='row'>
    <div class='col-md-12'>
      <div class="page-header">
        <span class='h2'>
          <%= I18n.t('huginn.events.your_events') %>
          <% if @agent %>
            <%= I18n.t('huginn.events.from_agent', agent_name: @agent.name) %>
          <% end %>
        </span>
        <% if @agent %>
          <%= render 'agents/mini_action_menu', agent: @agent, return_to: request.path %>
        <% end %>
      </div>

      <div class='table-responsive'>
        <table class='table table-striped table-row-middle events'>
          <tr>
            <% unless @agent %>
              <th><%= I18n.t('huginn.events.source') %></th>
            <% end %>
            <th><%= I18n.t('huginn.events.created') %></th>
            <th><%= I18n.t('huginn.events.payload') %></th>
            <th></th>
          </tr>

        <% @events.each do |event| %>
          <% next unless event.agent %>
          <%= content_tag :tr, class: (highlighted?(event.id) ? 'hl' : nil) do %>
            <% unless @agent %>
              <td><%= link_to event.agent.name, agent_path(event.agent, return: request.fullpath) %></td>
            <% end %>
            <td title='<%= event.created_at %>'><%= time_ago_in_words event.created_at %> <%= I18n.t('huginn.events.ago') %></td>
            <td class='payload'><%= truncate event.payload.to_json, :length => 90, :omission => "" %></td>
            <td>
              <div class="btn-group btn-group-xs">
                <%= link_to I18n.t('huginn.actions.show'), event_path(event, return: request.fullpath), class: "btn btn-default" %>
                <%= link_to I18n.t('huginn.actions.re_emit'), reemit_event_path(event), method: :post, data: { confirm: I18n.t('huginn.events.re_emit_confirm') }, class: "btn btn-default" %>
                <%= link_to I18n.t('huginn.actions.delete'), event_path(event), method: :delete, data: { confirm: I18n.t('huginn.actions.are_you_sure') }, class: "btn btn-default" %>
              </div>
            </td>
          <% end %>
        <% end %>
        </table>
      </div>

      <%= paginate @events, params: params.to_unsafe_h.slice(:hl), theme: 'twitter-bootstrap-3' %>

      <br />

      <% if @agent %>
        <div class="btn-group">
          <%= link_to icon_tag('glyphicon-chevron-left') + ' ' + I18n.t('huginn.actions.back'), filtered_agent_return_link || agents_path, class: "btn btn-default" %>
          <%= link_to icon_tag('glyphicon-random') + ' ' + I18n.t('huginn.events.see_all_events'), events_path, class: "btn btn-default" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
